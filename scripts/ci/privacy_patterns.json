{
  "version": 1,
  "description": "Generic pattern classes for scripts/ci/privacy_scan.py. Owner-specific strings never appear here: they come from the gitignored local file. Regexes are matched against Latin-1 decoded bytes (one character per byte) unless a rule sets ignorecase; keep them ASCII.",
  "placeholder_markers": [
    "<",
    ">",
    "*",
    "${",
    "{{",
    "%",
    "xxxx",
    "example",
    "synthetic",
    "placeholder",
    "redacted",
    "changeme",
    "dummy",
    "fake",
    "your-",
    "your_"
  ],
  "allowed_email_domains": [
    "example.com",
    "example.org",
    "example.net",
    "users.noreply.github.com",
    "noreply.github.com",
    "github.com"
  ],
  "allowed_email_suffixes": [".example", ".test", ".invalid", ".localhost"],
  "allowed_emails": ["git@github.com"],
  "generic_profile_names": [
    "public",
    "default",
    "default user",
    "all users",
    "runner",
    "runneradmin",
    "vsts",
    "ubuntu",
    "administrator",
    "user",
    "username",
    "shared"
  ],
  "rules": [
    {
      "id": "windows-user-profile-path",
      "class": "local-path",
      "pattern": "[A-Za-z]:[\\\\/]+Users[\\\\/]+([^\\\\/\\s\"'<>|:*?%$,;()\\[\\]{}]+)",
      "group": 1,
      "validator": "profile_name_not_generic"
    },
    {
      "id": "posix-home-or-users-path",
      "class": "local-path",
      "pattern": "(?:^|[^A-Za-z0-9_.~:])/(?:home|Users)/([A-Za-z0-9._-]+)/",
      "group": 1,
      "validator": "profile_name_not_generic"
    },
    {
      "id": "email-address",
      "class": "email",
      "pattern": "(?<![A-Za-z0-9._%+-])[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}",
      "ignorecase": true,
      "validator": "email_not_allowed"
    },
    {
      "id": "ipv4-address",
      "class": "ip-address",
      "pattern": "(?<![0-9.])(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(?![0-9]|\\.[0-9])",
      "validator": "ip_not_reserved"
    },
    {
      "id": "github-token",
      "class": "secret-token",
      "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{50,})\\b",
      "validator": "not_placeholder"
    },
    {
      "id": "aws-access-key-id",
      "class": "secret-token",
      "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
      "validator": "not_placeholder"
    },
    {
      "id": "google-api-key",
      "class": "secret-token",
      "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b",
      "validator": "not_placeholder"
    },
    {
      "id": "slack-token",
      "class": "secret-token",
      "pattern": "\\bxox[abposr]-[0-9A-Za-z-]{10,}",
      "validator": "not_placeholder"
    },
    {
      "id": "llm-api-key",
      "class": "secret-token",
      "pattern": "\\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{32,}",
      "validator": "not_placeholder"
    },
    {
      "id": "jwt",
      "class": "secret-token",
      "pattern": "\\beyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}",
      "validator": "not_placeholder"
    },
    {
      "id": "private-key-block",
      "class": "private-key",
      "pattern": "-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY(?: BLOCK)?-----"
    },
    {
      "id": "bearer-token",
      "class": "secret-token",
      "pattern": "\\bbearer\\s+([A-Za-z0-9._~+/=-]{20,})",
      "ignorecase": true,
      "group": 1,
      "validator": "not_placeholder"
    },
    {
      "id": "database-url-with-password",
      "class": "db-credentials",
      "pattern": "\\b(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\\+srv)?|redis|amqps?)://([^\\s:/@'\"<>]+):([^\\s@'\"<>]+)@",
      "ignorecase": true,
      "group": 2,
      "validator": "not_placeholder"
    },
    {
      "id": "password-config-assignment",
      "class": "db-credentials",
      "pattern": "\\b(?:db_)?password\\s*[:=]\\s*[\"']?([^\\s\"',;<>{}()]{6,})",
      "ignorecase": true,
      "group": 1,
      "path": "(?:^|/)(?:\\.env[^/]*|[^/]+\\.(?:toml|env|ini|cfg|conf|properties|ya?ml|json))$",
      "validator": "not_placeholder"
    },
    {
      "id": "secret-assignment",
      "class": "secret-token",
      "pattern": "\\b(?:api[_-]?key|secret|client[_-]?secret|access[_-]?token|auth[_-]?token|token|passwd|password)\\s*[:=]\\s*[\"']([A-Za-z0-9_./+=-]{20,})[\"']",
      "ignorecase": true,
      "group": 1,
      "validator": "not_placeholder_or_hex_digest"
    },
    {
      "id": "phone-international",
      "class": "personal-data",
      "pattern": "(?<![A-Za-z0-9+])\\+[0-9]{1,3}(?:[ .-][0-9]{1,4}){2,5}(?![0-9])",
      "validator": "phone_digit_count"
    },
    {
      "id": "phone-french-domestic",
      "class": "personal-data",
      "pattern": "(?<![0-9])0[1-9](?:[ .][0-9]{2}){4}(?![0-9])"
    },
    {
      "id": "phone-german-mobile",
      "class": "personal-data",
      "pattern": "(?<![0-9])01[5-7][0-9]{8,9}(?![0-9])"
    },
    {
      "id": "street-address",
      "class": "personal-data",
      "pattern": "(?<![A-Za-z0-9])[0-9]{1,4}[a-z]?,?\\s+(?:rue|avenue|av\\.|boulevard|bd|chemin|all.e|impasse|stra.{1,2}e|weg|platz|gasse|street|st\\.|road|lane)(?![A-Za-z])",
      "ignorecase": true
    },
    {
      "id": "date-of-birth-value",
      "class": "personal-data",
      "pattern": "(?:date of birth|geburtsdatum|date de naissance|n.{1,2} le|geboren am)\\s*[:-]?\\s*[0-9]",
      "ignorecase": true
    }
  ]
}

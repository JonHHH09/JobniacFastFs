{
  "candidate": {
    "crate": "unicode-segmentation",
    "unicode_version": "17.0.0",
    "version": "1.13.3"
  },
  "categories": {
    "abbreviation-internal-period": "A period, after the last non-space character before the boundary, is followed by a hyphen or a digit (for example c.-a-d. or Sec. 4.2)",
    "bullet-or-list-marker": "A bullet (U+2022), a numbered marker (1. or 1)), a parenthesised marker ((a)) or a dash or asterisk item is the token next to the boundary",
    "combining-or-format-mark": "A nonspacing, spacing or enclosing mark, or a format character (Cf), is within two code points of the boundary",
    "ellipsis-character": "U+2026 HORIZONTAL ELLIPSIS is within two code points of the boundary",
    "line-separator": "A CR, LF, NEL, U+2028 or U+2029 is within two code points of the boundary; UAX #29 breaks after each one (rule SB4), the reference segmentation breaks differently",
    "non-ascii-space-after-terminator": "A non-ASCII space (NBSP, U+2007, U+202F, U+3000) is within two code points of the boundary",
    "noncharacter": "A noncharacter (U+FFFE, U+FFFF and their plane equivalents) is within two code points of the boundary; the reference segmentation ends or changes processing there",
    "other": "Not explained by the categories above; must stay unused (the test fails if a text needs it)",
    "period-prefixed-token": "A stand-alone period token precedes the boundary and the next word starts with a letter",
    "punctuation-after-terminator": "Punctuation such as ; : ! ? ( ) guillemets or curly quotes is within two code points of the boundary",
    "terminator-before-symbol": "An astral character (U+1F000 and above: emoji, regional indicators, symbols) is within two code points of the boundary",
    "terminator-not-in-reference": "A character that UAX #29 treats as a sentence terminator and the reference segmentation does not (for example U+061F, U+203D, U+3002, U+FF61)",
    "unassigned-or-control": "An unassigned, control, private-use or surrogate-class code point is within two code points of the boundary",
    "unicode-version": "A character assigned in Unicode 17.0 and unassigned in the reference data (Unicode 16.0.0) is within two code points of the boundary"
  },
  "classifier": "crates/text/tests/sentences_golden.rs (classify_boundary, classify_text)",

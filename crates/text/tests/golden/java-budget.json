      "message": "Resume preparation limit exceeded",
      "details": {
       "field": "text",
       "reason": "exceeds preparation safety budget"
      }
     },
     "units": 1000000,
     "entries": 0
    },
    {
     "result": "ok",
     "units": 1000000,
     "entries": 0
    }
   ]
  },

   "steps": [
    {
     "op": "units",
     "count": 1000000
    },
    {
     "op": "text",
     "value": "a"
    },
    {
     "op": "units",
     "count": 0
    }
   ],
   "expected": [
    {
     "result": "ok",
     "units": 1000000,
     "entries": 0
    },
    {
     "result": "exceeded",
     "envelope": {

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Rust build output
/target

# Downloaded PDFium binaries (fetched by scripts/fetch-pdfium, never committed)
/vendor/

# Python bytecode of the CI scripts
__pycache__/

# Test and coverage output
coverage

# Local secrets and machine-specific state (never commit)
.env
.env.*
# The mock-IPC dev mode flag holds no secret (src/dev/README.md)
!.env.mock
*.pem
*.key
*.pfx
*.p12
.claude/settings.local.json
.claude/worktrees/
.remember/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Owner-specific privacy scan inputs and phrase fingerprints (scripts/ci/privacy_scan.py; never commit)
.privacy-local.json
.privacy-phrase-hashes.json

# Release staging: generated by scripts/release at release time, never committed
/src-tauri/binaries/
/src-tauri/resources/
/src-tauri/*.cdx.json
/crates/*/*.cdx.json
